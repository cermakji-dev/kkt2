generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  TECHNIK
  REFERENT
}

model Profile {
  id                  String     @id
  email               String     @unique
  name                String?
  phone               String?
  role                Role       @default(TECHNIK)
  active              Boolean    @default(true)
  createdAt           DateTime   @default(now())
  technicianBuildings Building[] @relation("BuildingTechnician")
  referentBuildings   Building[] @relation("BuildingReferent")
  tasks               Task[]     @relation("TaskAssignee")
  reports             InspectionReport[]
  loansIssued         KeyLoan[]  @relation("LoanIssuer")
  loansReceived       KeyLoan[]  @relation("LoanReceiver")
}

model Building {
  id          String       @id @default(cuid())
  name        String
  address     String
  units       Int?
  notes        String?
  technicianId String?
  technician   Profile?     @relation("BuildingTechnician", fields: [technicianId], references: [id], onDelete: SetNull)
  referentId   String?
  referent     Profile?     @relation("BuildingReferent", fields: [referentId], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  tasks        Task[]
  keys         KeySet[]
  inspections  Inspection[]
  reports      InspectionReport[]

  @@index([technicianId])
  @@index([referentId])
}

model Task {
  id         String     @id @default(cuid())
  title      String
  notes      String?
  status     TaskStatus @default(OPEN)
  dueAt      DateTime?
  buildingId String
  building   Building   @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  assigneeId String?
  assignee   Profile?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reportId   String?
  report     InspectionReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  createdAt  DateTime   @default(now())

  @@index([buildingId])
  @@index([assigneeId])
  @@index([reportId])
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
}

model KeySet {
  id          String    @id @default(cuid())
  code        String    @unique
  description String?
  count       Int?
  /// Aktuální držitel (kopie z aktivní výpůjčky kvůli rychlým přehledům)
  holder      String?
  borrowedAt  DateTime?
  buildingId  String
  building    Building  @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  loans       KeyLoan[]
  createdAt   DateTime  @default(now())

  @@index([buildingId])
}

model KeyLoan {
  id             String       @id @default(cuid())
  keySetId       String
  keySet         KeySet       @relation(fields: [keySetId], references: [id], onDelete: Cascade)
  holder         String
  holderPhone    String?
  holderCompany  String?
  purpose        String?
  borrowedAt     DateTime
  expectedReturn DateTime?
  returnedAt     DateTime?
  issuedById     String?
  issuedBy       Profile?     @relation("LoanIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  returnedToId   String?
  returnedTo     Profile?     @relation("LoanReceiver", fields: [returnedToId], references: [id], onDelete: SetNull)
  note           String?
  attachments    Attachment[]
  createdAt      DateTime     @default(now())

  @@index([keySetId])
  @@index([returnedAt])
}

model Inspection {
  id          String           @id @default(cuid())
  type        String
  buildingId  String
  building    Building         @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  inspectedAt DateTime
  nextDue     DateTime?
  result      InspectionResult @default(OK)
  notes       String?
  reportId    String?          @unique
  report      InspectionReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())

  @@index([buildingId])
}

enum ReportStatus {
  DRAFT
  FINAL
}

model InspectionReport {
  id          String       @id @default(cuid())
  buildingId  String
  building    Building     @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  template    String
  status      ReportStatus @default(DRAFT)
  date        DateTime
  inspectorId String?
  inspector   Profile?     @relation(fields: [inspectorId], references: [id], onDelete: SetNull)
  /// { [itemKey]: { s?: 'OK' | 'DEFECT' | 'NA', n?: string, task?: boolean } }
  items       Json         @default("{}")
  summary     String?
  nextDue     DateTime?
  svjName     String?
  attachments Attachment[]
  inspection  Inspection?
  tasks       Task[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  finalizedAt DateTime?

  @@index([buildingId])
}

enum AttachmentKind {
  PHOTO
  SIGNATURE_TECH
  SIGNATURE_SVJ
  SIGNATURE_HOLDER
  SIGNATURE_ISSUER
}

model Attachment {
  id        String            @id @default(cuid())
  reportId  String?
  report    InspectionReport? @relation(fields: [reportId], references: [id], onDelete: Cascade)
  loanId    String?
  loan      KeyLoan?          @relation(fields: [loanId], references: [id], onDelete: Cascade)
  kind      AttachmentKind
  itemKey   String?
  mime      String
  data      Bytes
  createdAt DateTime          @default(now())

  @@index([reportId])
  @@index([loanId])
}

enum InspectionResult {
  OK
  DEFECT
}
