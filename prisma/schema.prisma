generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  TECHNIK
  REFERENT
}

model Profile {
  id                  String     @id
  email               String     @unique
  name                String?
  phone               String?
  role                Role       @default(TECHNIK)
  active              Boolean    @default(true)
  /// Roční nárok na dovolenou (dny) a sick days
  vacationDays        Int        @default(20)
  sickDays            Int        @default(3)
  createdAt           DateTime   @default(now())
  technicianBuildings Building[] @relation("BuildingTechnician")
  referentBuildings   Building[] @relation("BuildingReferent")
  tasks               Task[]     @relation("TaskAssignee")
  tasksCreated        Task[]     @relation("TaskCreator")
  comments            TaskComment[] @relation("CommentAuthor")
  reports             InspectionReport[]
  loansIssued         KeyLoan[]  @relation("LoanIssuer")
  loansReceived       KeyLoan[]  @relation("LoanReceiver")
  attendance          AttendanceEvent[] @relation("AttendanceOwner")
  attendanceCreated   AttendanceEvent[] @relation("AttendanceCreator")
  leaves              LeaveRequest[]    @relation("LeaveOwner")
  leavesApproved      LeaveRequest[]    @relation("LeaveApprover")
}

model Building {
  id          String       @id @default(cuid())
  name        String
  address     String
  units       Int?
  notes        String?
  technicianId String?
  technician   Profile?     @relation("BuildingTechnician", fields: [technicianId], references: [id], onDelete: SetNull)
  referentId   String?
  referent     Profile?     @relation("BuildingReferent", fields: [referentId], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  tasks        Task[]
  keys         KeySet[]
  inspections  Inspection[]
  reports      InspectionReport[]

  @@index([technicianId])
  @@index([referentId])
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  notes       String?
  status      TaskStatus @default(OPEN)
  priority    Priority   @default(NONE)
  dueAt       DateTime?
  completedAt DateTime?
  sortOrder   Float      @default(0)
  buildingId  String?
  building    Building?  @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  assigneeId  String?
  assignee    Profile?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   Profile?   @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  parentId    String?
  parent      Task?      @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks    Task[]     @relation("Subtasks")
  comments    TaskComment[]
  reportId    String?
  report      InspectionReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt

  @@index([buildingId])
  @@index([assigneeId])
  @@index([reportId])
  @@index([parentId])
  @@index([status])
}

enum Priority {
  NONE
  LOW
  MEDIUM
  HIGH
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String?
  author    Profile? @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime @default(now())

  @@index([taskId])
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
}

model KeySet {
  id          String    @id @default(cuid())
  code        String    @unique
  description String?
  count       Int?
  /// Aktuální držitel (kopie z aktivní výpůjčky kvůli rychlým přehledům)
  holder      String?
  borrowedAt  DateTime?
  buildingId  String
  building    Building  @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  loans       KeyLoan[]
  createdAt   DateTime  @default(now())

  @@index([buildingId])
}

model KeyLoan {
  id             String       @id @default(cuid())
  keySetId       String
  keySet         KeySet       @relation(fields: [keySetId], references: [id], onDelete: Cascade)
  holder         String
  holderPhone    String?
  holderCompany  String?
  purpose        String?
  borrowedAt     DateTime
  expectedReturn DateTime?
  returnedAt     DateTime?
  issuedById     String?
  issuedBy       Profile?     @relation("LoanIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  returnedToId   String?
  returnedTo     Profile?     @relation("LoanReceiver", fields: [returnedToId], references: [id], onDelete: SetNull)
  note           String?
  attachments    Attachment[]
  createdAt      DateTime     @default(now())

  @@index([keySetId])
  @@index([returnedAt])
}

model Inspection {
  id          String           @id @default(cuid())
  type        String
  buildingId  String
  building    Building         @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  inspectedAt DateTime
  nextDue     DateTime?
  result      InspectionResult @default(OK)
  notes       String?
  reportId    String?          @unique
  report      InspectionReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())

  @@index([buildingId])
}

enum ReportStatus {
  DRAFT
  FINAL
}

model InspectionReport {
  id          String       @id @default(cuid())
  buildingId  String
  building    Building     @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  template    String
  status      ReportStatus @default(DRAFT)
  date        DateTime
  inspectorId String?
  inspector   Profile?     @relation(fields: [inspectorId], references: [id], onDelete: SetNull)
  /// { [itemKey]: { s?: 'OK' | 'DEFECT' | 'NA', n?: string, task?: boolean } }
  items       Json         @default("{}")
  summary     String?
  nextDue     DateTime?
  svjName     String?
  attachments Attachment[]
  inspection  Inspection?
  tasks       Task[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  finalizedAt DateTime?

  @@index([buildingId])
}

enum AttachmentKind {
  PHOTO
  SIGNATURE_TECH
  SIGNATURE_SVJ
  SIGNATURE_HOLDER
  SIGNATURE_ISSUER
}

model Attachment {
  id        String            @id @default(cuid())
  reportId  String?
  report    InspectionReport? @relation(fields: [reportId], references: [id], onDelete: Cascade)
  loanId    String?
  loan      KeyLoan?          @relation(fields: [loanId], references: [id], onDelete: Cascade)
  kind      AttachmentKind
  itemKey   String?
  mime      String
  data      Bytes
  createdAt DateTime          @default(now())

  @@index([reportId])
  @@index([loanId])
}

enum InspectionResult {
  OK
  DEFECT
}

enum AttendanceKind {
  PRICHOD
  ODCHOD
  SLUZEBNI_CESTA
  LEKAR
  HOME_OFFICE
}

model AttendanceEvent {
  id          String         @id @default(cuid())
  profileId   String
  profile     Profile        @relation("AttendanceOwner", fields: [profileId], references: [id], onDelete: Cascade)
  kind        AttendanceKind
  at          DateTime
  note        String?
  createdById String?
  createdBy   Profile?       @relation("AttendanceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())

  @@index([profileId, at])
}

enum LeaveType {
  DOVOLENA
  SICK_DAY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id           String      @id @default(cuid())
  profileId    String
  profile      Profile     @relation("LeaveOwner", fields: [profileId], references: [id], onDelete: Cascade)
  type         LeaveType   @default(DOVOLENA)
  from         DateTime
  to           DateTime
  days         Float
  status       LeaveStatus @default(PENDING)
  note         String?
  approverId   String?
  approver     Profile?    @relation("LeaveApprover", fields: [approverId], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime    @default(now())

  @@index([profileId])
  @@index([status])
}
