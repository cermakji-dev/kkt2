generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  TECHNIK
  REFERENT
}

model Profile {
  id                  String     @id
  email               String     @unique
  name                String?
  phone               String?
  role                Role       @default(TECHNIK)
  active              Boolean    @default(true)
  /// Roční nárok na dovolenou (dny) a sick days
  vacationDays        Int        @default(20)
  sickDays            Int        @default(3)
  createdAt           DateTime   @default(now())
  technicianBuildings Building[] @relation("BuildingTechnician")
  referentBuildings   Building[] @relation("BuildingReferent")
  tasks               Task[]     @relation("TaskAssignee")
  tasksCreated        Task[]     @relation("TaskCreator")
  comments            TaskComment[] @relation("CommentAuthor")
  reports             InspectionReport[]
  loansIssued         KeyLoan[]  @relation("LoanIssuer")
  loansReceived       KeyLoan[]  @relation("LoanReceiver")
  attendance          AttendanceEvent[] @relation("AttendanceOwner")
  attendanceCreated   AttendanceEvent[] @relation("AttendanceCreator")
  leaves              LeaveRequest[]    @relation("LeaveOwner")
  leavesApproved      LeaveRequest[]    @relation("LeaveApprover")
  readings            MeterReading[]
  documents           BuildingDocument[]
  ticketsAssigned     Ticket[]          @relation("TicketAssignee")
  ticketsCreated      Ticket[]          @relation("TicketCreator")
  ticketEvents        TicketEvent[]
}

model Building {
  id          String       @id @default(cuid())
  name        String
  address     String
  units       Int?
  notes        String?
  technicianId String?
  technician   Profile?     @relation("BuildingTechnician", fields: [technicianId], references: [id], onDelete: SetNull)
  referentId   String?
  referent     Profile?     @relation("BuildingReferent", fields: [referentId], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  tasks        Task[]
  keys         KeySet[]
  inspections  Inspection[]
  reports      InspectionReport[]
  code           String?
  ico            String?
  svjName        String?
  cadastralArea  String?
  yearBuilt      Int?
  floors         Int?
  entrances      Int?
  nonResidential Int?
  garages        Int?
  hasElevator    Boolean @default(false)
  hasGas         Boolean @default(false)
  hasBoiler      Boolean @default(false)
  hasChimney     Boolean @default(false)
  hasHydrants    Boolean @default(false)
  heating        String?
  contacts       BuildingContact[]
  unitList       Unit[]
  meters         Meter[]
  documents      BuildingDocument[]
  contracts      Contract[]
  tickets        Ticket[]

  @@index([technicianId])
  @@index([referentId])
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  notes       String?
  status      TaskStatus @default(OPEN)
  priority    Priority   @default(NONE)
  dueAt       DateTime?
  completedAt DateTime?
  sortOrder   Float      @default(0)
  buildingId  String?
  building    Building?  @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  assigneeId  String?
  assignee    Profile?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   Profile?   @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  parentId    String?
  parent      Task?      @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks    Task[]     @relation("Subtasks")
  comments    TaskComment[]
  reportId    String?
  report      InspectionReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  ticket      Ticket?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt

  @@index([buildingId])
  @@index([assigneeId])
  @@index([reportId])
  @@index([parentId])
  @@index([status])
}

enum Priority {
  NONE
  LOW
  MEDIUM
  HIGH
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String?
  author    Profile? @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime @default(now())

  @@index([taskId])
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
}

model KeySet {
  id          String    @id @default(cuid())
  code        String    @unique
  description String?
  count       Int?
  /// Aktuální držitel (kopie z aktivní výpůjčky kvůli rychlým přehledům)
  holder      String?
  borrowedAt  DateTime?
  buildingId  String
  building    Building  @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  loans       KeyLoan[]
  createdAt   DateTime  @default(now())

  @@index([buildingId])
}

model KeyLoan {
  id             String       @id @default(cuid())
  keySetId       String
  keySet         KeySet       @relation(fields: [keySetId], references: [id], onDelete: Cascade)
  holder         String
  holderPhone    String?
  holderCompany  String?
  purpose        String?
  borrowedAt     DateTime
  expectedReturn DateTime?
  returnedAt     DateTime?
  issuedById     String?
  issuedBy       Profile?     @relation("LoanIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  returnedToId   String?
  returnedTo     Profile?     @relation("LoanReceiver", fields: [returnedToId], references: [id], onDelete: SetNull)
  note           String?
  attachments    Attachment[]
  createdAt      DateTime     @default(now())

  @@index([keySetId])
  @@index([returnedAt])
}

model Inspection {
  id          String           @id @default(cuid())
  type        String
  buildingId  String
  building    Building         @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  inspectedAt DateTime
  nextDue     DateTime?
  result      InspectionResult @default(OK)
  notes       String?
  reportId    String?          @unique
  report      InspectionReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())

  @@index([buildingId])
}

enum ReportStatus {
  DRAFT
  FINAL
}

model InspectionReport {
  id          String       @id @default(cuid())
  buildingId  String
  building    Building     @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  template    String
  status      ReportStatus @default(DRAFT)
  date        DateTime
  inspectorId String?
  inspector   Profile?     @relation(fields: [inspectorId], references: [id], onDelete: SetNull)
  /// { [itemKey]: { s?: 'OK' | 'DEFECT' | 'NA', n?: string, task?: boolean } }
  items       Json         @default("{}")
  summary     String?
  nextDue     DateTime?
  svjName     String?
  attachments Attachment[]
  inspection  Inspection?
  tasks       Task[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  finalizedAt DateTime?

  @@index([buildingId])
}

enum AttachmentKind {
  PHOTO
  SIGNATURE_TECH
  SIGNATURE_SVJ
  SIGNATURE_HOLDER
  SIGNATURE_ISSUER
}

model Attachment {
  id        String            @id @default(cuid())
  reportId  String?
  report    InspectionReport? @relation(fields: [reportId], references: [id], onDelete: Cascade)
  loanId    String?
  loan      KeyLoan?          @relation(fields: [loanId], references: [id], onDelete: Cascade)
  kind      AttachmentKind
  itemKey   String?
  mime      String
  data      Bytes
  createdAt DateTime          @default(now())

  @@index([reportId])
  @@index([loanId])
}

enum InspectionResult {
  OK
  DEFECT
}

enum AttendanceKind {
  PRICHOD
  ODCHOD
  SLUZEBNI_CESTA
  LEKAR
  HOME_OFFICE
}

model AttendanceEvent {
  id          String         @id @default(cuid())
  profileId   String
  profile     Profile        @relation("AttendanceOwner", fields: [profileId], references: [id], onDelete: Cascade)
  kind        AttendanceKind
  at          DateTime
  note        String?
  createdById String?
  createdBy   Profile?       @relation("AttendanceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())

  @@index([profileId, at])
}

enum LeaveType {
  DOVOLENA
  SICK_DAY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id           String      @id @default(cuid())
  profileId    String
  profile      Profile     @relation("LeaveOwner", fields: [profileId], references: [id], onDelete: Cascade)
  type         LeaveType   @default(DOVOLENA)
  from         DateTime
  to           DateTime
  days         Float
  status       LeaveStatus @default(PENDING)
  note         String?
  approverId   String?
  approver     Profile?    @relation("LeaveApprover", fields: [approverId], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime    @default(now())

  @@index([profileId])
  @@index([status])
}

enum ContactRole {
  PREDSEDA
  MISTOPREDSEDA
  CLEN_VYBORU
  DOMOVNIK
  SPRAVCE
  KONTAKT
}

model BuildingContact {
  id         String      @id @default(cuid())
  buildingId String
  building   Building    @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  role       ContactRole @default(KONTAKT)
  name       String
  phone      String?
  email      String?
  unitLabel  String?
  note       String?
  createdAt  DateTime    @default(now())

  @@index([buildingId])
}

enum UnitType {
  BYT
  NEBYT
  GARAZ
  SKLEP
}

model Unit {
  id         String   @id @default(cuid())
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  label      String
  type       UnitType @default(BYT)
  floor      Int?
  area       Float?
  entrance   String?
  ownerName  String?
  ownerPhone String?
  ownerEmail String?
  note       String?
  meters     Meter[]
  createdAt  DateTime @default(now())

  @@unique([buildingId, label])
  @@index([buildingId])
}

enum MeterKind {
  SV
  TUV
  TEPLO
  ELEKTRO
  PLYN
  RTN
}

model Meter {
  id            String         @id @default(cuid())
  buildingId    String
  building      Building       @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  unitId        String?
  unit          Unit?          @relation(fields: [unitId], references: [id], onDelete: SetNull)
  kind          MeterKind
  serial        String
  location      String?
  verifiedUntil DateTime?
  note          String?
  readings      MeterReading[]
  createdAt     DateTime       @default(now())

  @@index([buildingId])
}

model MeterReading {
  id          String   @id @default(cuid())
  meterId     String
  meter       Meter    @relation(fields: [meterId], references: [id], onDelete: Cascade)
  date        DateTime
  value       Float
  note        String?
  createdById String?
  createdBy   Profile? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([meterId, date])
}

enum DocCategory {
  SMLOUVA
  REVIZNI_ZPRAVA
  PROJEKT
  ZAPIS
  PASPORT
  FOTO
  JINE
}

model BuildingDocument {
  id           String      @id @default(cuid())
  buildingId   String
  building     Building    @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  title        String
  category     DocCategory @default(JINE)
  fileName     String
  mime         String
  size         Int
  data         Bytes
  uploadedById String?
  uploadedBy   Profile?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())

  @@index([buildingId])
}

model Supplier {
  id             String     @id @default(cuid())
  name           String
  ico            String?
  category       String     @default("JINE")
  contactName    String?
  phone          String?
  emergencyPhone String?
  email          String?
  web            String?
  note           String?
  active         Boolean    @default(true)
  contracts      Contract[]
  tickets        Ticket[]
  createdAt      DateTime   @default(now())
}

model Contract {
  id         String    @id @default(cuid())
  supplierId String
  supplier   Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  buildingId String?
  building   Building? @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  title      String
  validFrom  DateTime?
  validTo    DateTime?
  noticeDays Int?
  autoRenew  Boolean   @default(false)
  price      String?
  note       String?
  createdAt  DateTime  @default(now())

  @@index([supplierId])
  @@index([buildingId])
}

enum TicketStatus {
  NOVE
  PRIJATO
  PREDANO
  RESI_SE
  VYRESENO
  ZAMITNUTO
}

enum TicketUrgency {
  HAVARIE
  VYSOKA
  BEZNA
}

enum TicketChannel {
  TELEFON
  EMAIL
  OSOBNE
  KONTROLA
  JINE
}

model Ticket {
  id            String        @id @default(cuid())
  number        Int           @unique @default(autoincrement())
  buildingId    String
  building      Building      @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  unitLabel     String?
  title         String
  description   String?
  category      String        @default("JINE")
  urgency       TicketUrgency @default(BEZNA)
  status        TicketStatus  @default(NOVE)
  channel       TicketChannel @default(TELEFON)
  reporterName  String?
  reporterPhone String?
  reporterEmail String?
  assigneeId    String?
  assignee      Profile?      @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  supplierId    String?
  supplier      Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  taskId        String?       @unique
  task          Task?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdById   String?
  createdBy     Profile?      @relation("TicketCreator", fields: [createdById], references: [id], onDelete: SetNull)
  dueAt         DateTime?
  resolvedAt    DateTime?
  events        TicketEvent[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt

  @@index([buildingId])
  @@index([status])
}

model TicketEvent {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String?
  author    Profile? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  kind      String   @default("COMMENT")
  body      String
  createdAt DateTime @default(now())

  @@index([ticketId])
}
