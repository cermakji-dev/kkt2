generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  TECHNIK
  REFERENT
}

model Profile {
  id                  String     @id
  email               String     @unique
  name                String?
  phone               String?
  role                Role       @default(TECHNIK)
  active              Boolean    @default(true)
  createdAt           DateTime   @default(now())
  technicianBuildings Building[] @relation("BuildingTechnician")
  referentBuildings   Building[] @relation("BuildingReferent")
  tasks               Task[]     @relation("TaskAssignee")
}

model Building {
  id          String       @id @default(cuid())
  name        String
  address     String
  units       Int?
  notes        String?
  technicianId String?
  technician   Profile?     @relation("BuildingTechnician", fields: [technicianId], references: [id], onDelete: SetNull)
  referentId   String?
  referent     Profile?     @relation("BuildingReferent", fields: [referentId], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  tasks        Task[]
  keys         KeySet[]
  inspections  Inspection[]

  @@index([technicianId])
  @@index([referentId])
}

model Task {
  id         String     @id @default(cuid())
  title      String
  notes      String?
  status     TaskStatus @default(OPEN)
  dueAt      DateTime?
  buildingId String
  building   Building   @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  assigneeId String?
  assignee   Profile?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt  DateTime   @default(now())

  @@index([buildingId])
  @@index([assigneeId])
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
}

model KeySet {
  id          String    @id @default(cuid())
  code        String    @unique
  description String?
  holder      String?
  borrowedAt  DateTime?
  buildingId  String
  building    Building  @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now())

  @@index([buildingId])
}

model Inspection {
  id          String           @id @default(cuid())
  type        String
  buildingId  String
  building    Building         @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  inspectedAt DateTime
  nextDue     DateTime?
  result      InspectionResult @default(OK)
  notes       String?
  createdAt   DateTime         @default(now())

  @@index([buildingId])
}

enum InspectionResult {
  OK
  DEFECT
}
